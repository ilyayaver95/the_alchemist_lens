# Copy to .env and fill in. Never commit .env.

# Which vision provider to use: gemini | ollama
VISION_PROVIDER=gemini

# Gemini (get a free key at https://aistudio.google.com)
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash

# Ollama (offline fallback; run `ollama pull qwen2.5vl:7b` first)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

# Response cache (saves free-tier quota on repeated requests)
CACHE_ENABLED=true
CACHE_DIR=.cache
