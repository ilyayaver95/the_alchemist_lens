# Copy to .env and fill in. Never commit .env.

# Which vision provider to use: gemini | ollama
VISION_PROVIDER=gemini

# Gemini (get a free key at https://aistudio.google.com)
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash

# Ollama (offline fallback; run `ollama pull qwen2.5vl:7b` first)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

# Response cache (saves free-tier quota on repeated requests)
CACHE_ENABLED=true
CACHE_DIR=.cache

# Accounts and favorites. SQLite locally; Render injects a Postgres URL.
DATABASE_URL=sqlite:///./alchemist.db
# Signs the session cookie. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-something-random
# Set true wherever the app is served over HTTPS (required in production).
COOKIE_SECURE=false

# Retailer used by the "build bucket list" links
PANECO_BASE_URL=https://www.paneco.co.il

# Allow the home-bar screen to spend an LLM call inventing an original drink
ENABLE_INVENTION=true
